# FlyQM API - example configuration.
# Copy to .env (repo root; used by infra/docker-compose.yml and by uvicorn run
# from backend/ if you copy it there) and fill in real values. Never commit .env.

# --- Database -------------------------------------------------------------
# Docker Compose: the backend reaches Postgres at host "db", port 5432.
# Local uvicorn against the compose DB: postgresql://airuser:airpassword@localhost:5433/airdb
DATABASE_URL=postgresql://airuser:airpassword@db:5432/airdb
# Used by the compose "db" service to initialise Postgres (local dev only).
POSTGRES_USER=airuser
POSTGRES_PASSWORD=airpassword
POSTGRES_DB=airdb

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- External APIs --------------------------------------------------------
# RapidAPI key for the flight search provider
TICKET_API_KEY=your-rapidapi-key

# --- HTTP -----------------------------------------------------------------
APP_NAME=FlyQM API
# Comma-separated browser origins allowed by CORS (the React app), or "*"
CORS_ORIGINS=http://localhost:5173,https://flyqm.com
# Port uvicorn listens on inside the container (hosts may inject PORT)
PORT=8000
# Run the booking auto-cancel/complete job in this instance
ENABLE_SCHEDULER=true
