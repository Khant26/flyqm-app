# Copy to .env (or .env.local) and adjust. Never commit the real .env file.
# Only VITE_* variables are exposed to the browser bundle - never put secrets here.

# Base URL of the FlyQM FastAPI service, including its /api prefix.
# Used by both the customer site (/) and the admin dashboard (/admin).
# Default when unset: "/api" (same origin). On Vercel set the full URL, e.g.
#   VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=/api

# Dev server only (npm run dev): where requests to /api are proxied.
VITE_DEV_API_PROXY=http://localhost:8000
